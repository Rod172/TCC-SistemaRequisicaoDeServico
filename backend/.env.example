# Configurações do Servidor
PORT=3001
NODE_ENV=development

# Configurações do Banco de Dados MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=tcc_eloserv
DB_NAME_TEST=tcc_eloserv_test

# Configuração de Segurança (JWT)
# Gerar localmente: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=1d
